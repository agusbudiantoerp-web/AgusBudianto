rades in automotive parts; and manufactures and sells electrical appliances. It distributes its products through dealers, sales offices, and retailers. The company was formerly known as PT Astra Dian Lestari and changed its name to PT Astra Otoparts Tbk in November 1997. PT Astra Otoparts Tbk was founded in 1976 and is headquartered in Jakarta, Indonesia. PT Astra Otoparts Tbk is a subsidiary of PT Astra International Tbk.","fullTimeEmployees":6884,"companyOfficers":[{"maxAge":1,"name":"Mr. Yusak Kristian Solaeman","age":53,"title":"President Director","yearBorn":1972,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Handoyo  Prasetyo","title":"Director of Corp. Legal, Corp. Secretary & Public Relations","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. .  Suryaningrum","age":52,"title":"Chief Audit Executive","yearBorn":1973,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":2980.0,"fmt":"2,980.00"},"open":{"raw":2980.0,"fmt":"2,980.00"},"dayLow":{"raw":2980.0,"fmt":"2,980.00"},"dayHigh":{"raw":3010.0,"fmt":"3,010.00"},"regularMarketPreviousClose":{"raw":2980.0,"fmt":"2,980.00"},"regularMarketOpen":{"raw":2980.0,"fmt":"2,980.00"},"regularMarketDayLow":{"raw":2980.0,"fmt":"2,980.00"},"regularMarketDayHigh":{"raw":3010.0,"fmt":"3,010.00"},"dividendRate":{"raw":242.52,"fmt":"242.52"},"dividendYield":{"raw":0.08140001,"fmt":"8.14%"},"exDividendDate":{"raw":1791936000,"fmt":"2026-10-14"},"payoutRatio":{"raw":0.45349997,"fmt":"45.35%"},"fiveYearAvgDividendYield":{"raw":5.24,"fmt":"5.24"},"beta":{"raw":0.111,"fmt":"0.11"},"trailingPE":{"raw":5.960396,"fmt":"5.96"},"forwardPE":{"raw":7.271058,"fmt":"7.27"},"volume":{"raw":370900,"fm