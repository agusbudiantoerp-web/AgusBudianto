iary of PT Global Mediacom Tbk.","fullTimeEmployees":3662,"companyOfficers":[{"maxAge":1,"name":"Mr. .  Noersing MBA","age":56,"title":"President Director","yearBorn":1969,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Ruby  Panjaitan","age":56,"title":"Finance Director & Director","yearBorn":1969,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Teddy  Pun","title":"Head of Investor Relation and Corporate Finance","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Kanti Mirdiati Imansyah","age":59,"title":"Director of Sales & Marketing and Director","yearBorn":1966,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Gwenarty  Setiadi","age":63,"title":"Director of Human Resources & Organization Development","yearBorn":1962,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Fauzi  Badjened","age":38,"title":"Head of Internal Audit Unit","yearBorn":1987,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Cahyarina Agustina Asri","age":52,"title":"Corporate Secretary & Director","yearBorn":1973,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":80.0,"fmt":"80.00"},"open":{"raw":81.0,"fmt":"81.00"},"dayLow":{"raw":80.0,"fmt":"80.00"},"dayHigh":{"raw":84.0,"fmt":"84.00"},"regularMarketPreviousClose":{"raw":80.0,"fmt":"80.00"},"regularMarketOpen":{"raw":81.0,"fmt":"81.00"},"regularMarketDayLow":{"raw":80.0,"fmt"