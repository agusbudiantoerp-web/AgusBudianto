 in the mining of aggregates and trass; shipping; port management; outsourcing; construction; and trading activities. The company exports its products. The company was founded in 1975 and is headquartered in Jakarta, Indonesia. PT Indocement Tunggal Prakarsa Tbk operates as a subsidiary of Heidelberg Materials AG.","fullTimeEmployees":4145,"companyOfficers":[{"maxAge":1,"name":"Mr. Christian  Kartawijaya","age":57,"title":"President Director","yearBorn":1968,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Hendrikus  Amino","title":"Special Audit & Administration Group Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. David  Halim","age":47,"title":"Investor Relation Manager","yearBorn":1978,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Indra  Andhika","title":"RBAG 1 Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Martinus  Budianto","title":"RBAG 2 Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":".  Hermanto","title":"RBAG 3 Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Dani  Handajani","age":54,"title":"Company Secretary","yearBorn":1971,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":5800.0,"fmt":"5,800.00"},"open":{"raw":5700.0,"fmt":"5,700.00"},"dayLow":{"raw":5700.0,"fmt":"5,700.00"},"dayHigh":{"raw":5850.0,"fmt":"5,850.00"},"regularMarketPreviousClose":{"raw":5800.0,"fmt":"