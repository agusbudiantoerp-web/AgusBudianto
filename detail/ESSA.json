 in October 2023. PT ESSA Industries Indonesia Tbk. was founded in 2006 and is headquartered in Jakarta, Indonesia.","fullTimeEmployees":487,"companyOfficers":[{"maxAge":1,"name":"Mr. Kanishk  Laroya","age":38,"title":"CEO & President Director","yearBorn":1987,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Prakash Chand Bumb","age":62,"title":"CFO & Director","yearBorn":1963,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Mukesh  Agrawal","age":56,"title":"COO & Director","yearBorn":1969,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Ferdinand L. Tobing","age":45,"title":"Head of Legal","yearBorn":1980,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Haresh  Babani","title":"Head of Marketing","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Ira D. Kamal","title":"Human Capital Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Sholeh  Ismail","title":"Head of Plant Commercial","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Sumit  Dudeja","age":44,"title":"Internal Audit Head","yearBorn":1981,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Deepak  Khullar","title":"Capital & Risk Management Head","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Santosh  Sigdel","title":"Head of Finance","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"une