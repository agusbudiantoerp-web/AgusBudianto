 polyolefins, styrene monomer, and butadiene, including by-products. It also operates geothermal energy resources and wind power plant projects. In addition, the company engages in the development and construction of industrial and commercial properties; marine transportation; logistics; and glue production for particleboards. Further, it provides management consultation services. The company was formerly known as PT Barito Pacific Timber Tbk and changed its name to PT Barito Pacific Tbk in August 2007. PT Barito Pacific Tbk was founded in 1979 and is headquartered in Jakarta, Indonesia.","fullTimeEmployees":5303,"companyOfficers":[{"maxAge":1,"name":"Mr. Agus Salim Pangestu","age":52,"title":"President Director","yearBorn":1973,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Rudy  Suparman","age":66,"title":"Vice President Director","yearBorn":1959,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. David  Kosasih","age":51,"title":"Finance and Accounting Director, Secretary & Director","yearBorn":1974,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":730.0,"fmt":"730.00"},"open":{"raw":750.0,"fmt":"750.00"},"dayLow":{"raw":730.0,"fmt":"730.00"},"dayHigh":{"raw":810.0,"fmt":"810.00"},"regularMarketPreviousClose":{"raw":730.0,"fmt":"730.00"},"regularMarketOpen":{"raw":750.0,"fmt":"750.00"},"regularMarketDayLow":{"raw":730.0,"fmt":"730.00"},"regularMarketDayHigh":{"raw":810.0,"fmt":"810.00"},"dividendRate":{"raw":1.63,"fmt":"1.63"},"dividendYield":{"raw":0.0022,"fmt":"0.22%"},"exDividendDate":{"raw":1783296000,"fmt":"2026-07-06"},"payoutRatio":{"raw":0.0659,"fmt":"6.59%"},"fiveYearAvgDividendYield":{"raw":0.14,"fmt":"0.14